{
  "name": "dottie-mac-use",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "macOS agent tools + AX/EventKit CLI — standalone MCP/HTTP, no Dottie.app required",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevederico/dottie-mac-use.git"
  },
  "bugs": {
    "url": "https://github.com/stevederico/dottie-mac-use/issues"
  },
  "homepage": "https://github.com/stevederico/dottie-mac-use#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./tools/*": "./tools/*",
    "./mcp.js": "./mcp.js",
    "./http.js": "./http.js",
    "./tool_runtime.js": "./tool_runtime.js",
    "./vision_client.js": "./vision_client.js",
    "./permissions.js": "./permissions.js",
    "./ports.js": "./ports.js",
    "./logger.js": "./logger.js",
    "./ax_process.js": "./ax_process.js",
    "./domains.js": "./domains.js"
  },
  "bin": {
    "dottie-mac-use": "./mcp.js"
  },
  "scripts": {
    "build:ax": "bash native/build.sh",
    "mcp": "node mcp.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "devDependencies": {
    "vitest": "^4.1.4"
  }
}
